<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!--
      允许从"远程位置"加载程序集 —— 打包版必需，请勿删除。

      背景：Windows 会给"从网上下载 / 从网络位置复制"来的文件打上
      Mark of the Web（备用数据流 Zone.Identifier，ZoneId=3）。.NET Framework
      看到这个标记，会把 Python.Runtime.dll 等程序集判定为"网络位置"，
      按安全策略拒绝 Assembly.LoadFrom，表现为一启动就崩：

        RuntimeError: Failed to resolve Python.Runtime.Loader.Initialize
        from ...\_internal\pythonnet\runtime\Python.Runtime.dll

      受影响的不止是下载回来的副本：程序目录若放在含中文等非 ASCII 字符的
      路径下，.NET 的路径解析同样会把程序集判为远程，报同一个错。

      开启本开关后，无论文件是否带 Mark of the Web、安装路径是否含中文，
      都能正常加载。（本文件必须与 BeatSync.exe 放在同一层目录，
      由 BeatSync.spec 的构建后步骤自动复制过去。）
    -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
