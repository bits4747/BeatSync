# 统一换行策略：入库归一化为 LF，检出时按各平台默认换行。
# 不用 eol=crlf —— 那会在 checkout 时把工作区文件整体改写成 CRLF，
# 与仓库现有 LF 内容产生整文件 diff，掩盖真实改动。
* text=auto

# 明确按文本处理的源码
*.py     text
*.js     text
*.css    text
*.html   text
*.md     text
*.txt    text
*.bat    text
*.iss    text
*.spec   text

# 二进制资源不参与换行转换
*.ico    binary
*.png    binary
*.exe    binary
